# Set one of these keys. If both are set, Anthropic is used unless AI_PROVIDER says otherwise.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional: force a provider (anthropic | openai)
# AI_PROVIDER=anthropic

# Optional: override models
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-4.1
